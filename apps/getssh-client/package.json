{
  "name": "getssh",
  "version": "3.0.0-rc.1",
  "getsshRelease": {
    "stage": "RC",
    "edition": "FUSION",
    "program": "preview"
  },
  "packageManager": "pnpm@11.2.2",
  "main": "dist-electron/main/index.js",
  "description": "Electron React SSH Client with Glassmorphism",
  "author": "Shen Jiangchen <shenjiangchen@example.com>",
  "scripts": {
    "prebuild": "node -e \"if (!['darwin', 'win32'].includes(process.platform)) throw new Error('GETSSH desktop builds are supported only on macOS and Windows.')\"",
    "dev": "vite",
    "postinstall": "electron-builder install-app-deps",
    "build": "pnpm run build:native-tools && vite build && electron-builder",
    "build:native-tools": "cargo build --release -p ocean-sentinel --no-default-features --bins",
    "build:watchdog": "cargo build --release -p ocean-sentinel --no-default-features --bin watchdog",
    "build:plugin": "node scripts/package-plugin.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:plugin-isolation": "electron scripts/security/plugin-host-smoke.cjs",
    "test:plugin-network": "vitest run electron/main/services/plugin/PluginNetworkGateway.test.ts --environment node",
    "test:plugin-sandbox": "vitest run electron/main/services/plugin/PluginProcessSandbox.test.ts --environment node",
    "test:database-encryption": "electron scripts/security/database-key-smoke.cjs",
    "test:asset-folders": "node scripts/security/keystore-e2e/run.mjs asset-folders",
    "test:local-memory": "vitest run electron/main/services/LocalMemoryService.test.ts --environment node",
    "test:sentinel": "vitest run electron/main/services/OceanSentinel.test.ts --environment node && node scripts/security/sentinel-smoke.cjs",
    "test:mcp-sandbox": "vitest run electron/main/services/mcp/McpProcessSandbox.test.ts --environment node",
    "test:packaged-startup": "node scripts/security/packaged-startup-smoke.cjs",
    "test:package-contents": "node scripts/check-package.cjs",
    "test:keystore-e2e": "node scripts/security/keystore-e2e/run.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "archiver": "^8.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "framer-motion": "13.4.6",
    "fuse.js": "^7.5.0",
    "http-proxy-agent": "^9.1.0",
    "i18next": "^26.4.2",
    "immer": "^11.1.18",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.49.0",
    "p-limit": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "socks": "^2.8.10",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.getssh.app",
    "productName": "GETSSH",
    "publish": {
      "provider": "github",
      "owner": "JiangchenShen",
      "repo": "GETSSH"
    },
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "files": [
        "package.json",
        "!**/node_modules/better-sqlite3-multiple-ciphers/prebuilds/darwin*"
      ],
      "icon": "build/icon.ico"
    },
    "directories": {
      "buildResources": "build",
      "output": "../../dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "../../target/release",
        "to": ".",
        "filter": [
          "watchdog",
          "watchdog.exe",
          "getssh-sandbox.exe"
        ]
      },
      {
        "from": "../../rust-core/getssh-kv",
        "to": "rust-core/getssh-kv",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/getssh-sysprobe",
        "to": "rust-core/getssh-sysprobe",
        "filter": [
          "*.node",
          "index.node",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/getssh-vault",
        "to": "rust-core/getssh-vault",
        "filter": [
          "*.node",
          "index.node",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/getssh-unarchive",
        "to": "rust-core/getssh-unarchive",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/sftp-stream",
        "to": "rust-core/sftp-stream",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/tidal-engine",
        "to": "rust-core/tidal-engine",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/audit-stream",
        "to": "rust-core/audit-stream",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/ocean-sentinel",
        "to": "rust-core/ocean-sentinel",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/getssh-keystore",
        "to": "rust-core/getssh-keystore",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/getssh-store",
        "to": "rust-core/getssh-store",
        "filter": [
          "*.node",
          "index.js",
          "package.json",
          "!store.fake.js",
          "!node_modules",
          "!src",
          "!target",
          "!vendor"
        ]
      }
    ],
    "files": [
      "dist/index.html",
      "dist/favicon.ico",
      "dist/logo.png",
      "dist/assets/**/*",
      "dist/plugins/**/*",
      "!dist/plugins/test-plugin/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/*.md",
      "!**/*.txt",
      "!**/LICENSE*",
      "!**/CHANGELOG*",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/docs/**",
      "!**/example/**",
      "!**/examples/**",
      "!**/.github/**",
      "!**/node_modules/.cache/**",
      "!../../rust-core/**/node_modules/**",
      "!**/node_env/**",
      "!**/sftp-mock-plugin/**",
      "!**/@types/**",
      "!**/node_modules/better-sqlite3-multiple-ciphers/{deps,src,build}/**",
      "!**/node_modules/better-sqlite3-multiple-ciphers/binding.gyp",
      "!**/node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*",
      "!**/.DS_Store",
      "!src/**/*"
    ],
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0",
      "files": [
        "package.json",
        "!**/node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32*"
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Install GETSSH",
      "format": "ULFO",
      "background": "build/background.png",
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "GETSSH Uninstaller",
      "shortcutName": "GETSSH",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
