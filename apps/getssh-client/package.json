{
  "name": "getssh",
  "version": "3.0.0-F0A0G-PREVIEW",
  "packageManager": "pnpm@11.2.2",
  "main": "dist-electron/main/index.js",
  "description": "Electron React SSH Client with Glassmorphism",
  "author": "Shen Jiangchen <shenjiangchen@example.com>",
  "scripts": {
    "prebuild": "node -e \"if (!['darwin', 'win32'].includes(process.platform)) throw new Error('GETSSH desktop builds are supported only on macOS and Windows.')\"",
    "dev": "vite",
    "postinstall": "electron-builder install-app-deps",
    "build": "pnpm run build:native-tools && vite build && electron-builder",
    "build:native-tools": "cargo build --release -p watchdog -p getssh-process-sandbox",
    "build:watchdog": "cargo build --release -p watchdog",
    "build:plugin": "node scripts/package-plugin.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:plugin-isolation": "electron scripts/security/plugin-host-smoke.cjs",
    "test:plugin-network": "vitest run electron/main/services/plugin/PluginNetworkGateway.test.ts --environment node",
    "test:plugin-sandbox": "vitest run electron/main/services/plugin/PluginProcessSandbox.test.ts --environment node",
    "test:database-encryption": "electron scripts/security/database-key-smoke.cjs",
    "test:local-memory": "vitest run electron/main/services/LocalMemoryService.test.ts --environment node",
    "test:sentinel": "vitest run electron/main/services/SentinelGateway.test.ts --environment node && node scripts/security/sentinel-smoke.cjs",
    "test:mcp-sandbox": "vitest run electron/main/services/mcp/McpProcessSandbox.test.ts --environment node",
    "test:packaged-startup": "node scripts/security/packaged-startup-smoke.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xterm/addon-serialize": "^0.14.0",
    "adm-zip": "^0.5.18",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.4.0",
    "immer": "^11.1.8",
    "node-pty": "^1.1.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.11.19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.5",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "archiver": "^8.0.0",
    "dompurify": "^3.4.7",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "http-proxy-agent": "^9.0.0",
    "i18next": "^26.0.7",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.17.0",
    "p-limit": "^7.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.4",
    "socks": "^2.8.9",
    "tailwindcss": "4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.6",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.getssh.app",
    "productName": "GETSSH",
    "publish": {
      "provider": "github",
      "owner": "JiangchenShen",
      "repo": "GETSSH"
    },
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "directories": {
      "buildResources": "build",
      "output": "../../dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "../../target/release",
        "to": ".",
        "filter": [
          "watchdog",
          "watchdog.exe",
          "getssh-sandbox.exe"
        ]
      },
      {
        "from": "../../rust-core/getssh-kv",
        "to": "rust-core/getssh-kv",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/getssh-sysprobe",
        "to": "rust-core/getssh-sysprobe",
        "filter": [
          "*.node",
          "index.node",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/getssh-vault",
        "to": "rust-core/getssh-vault",
        "filter": [
          "*.node",
          "index.node",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/getssh-unarchive",
        "to": "rust-core/getssh-unarchive",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/sftp-stream",
        "to": "rust-core/sftp-stream",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/nexus-core",
        "to": "rust-core/nexus-core",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/audit-stream",
        "to": "rust-core/audit-stream",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      },
      {
        "from": "../../rust-core/getssh-sentinel",
        "to": "rust-core/getssh-sentinel",
        "filter": [
          "*.node",
          "*.js",
          "package.json",
          "!node_modules",
          "!src",
          "!target"
        ]
      }
    ],
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist/plugins/**/*",
      "!dist/plugins/test-plugin/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/*.md",
      "!**/*.txt",
      "!**/LICENSE*",
      "!**/CHANGELOG*",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/docs/**",
      "!**/example/**",
      "!**/examples/**",
      "!**/.github/**",
      "!**/node_modules/.cache/**",
      "!../../rust-core/**/node_modules/**",
      "!**/node_env/**",
      "!**/sftp-mock-plugin/**",
      "!**/@types/**",
      "!**/.DS_Store",
      "!src/**/*"
    ],
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "title": "Install GETSSH",
      "format": "ULFO",
      "background": "build/background.png",
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "GETSSH Uninstaller",
      "shortcutName": "GETSSH",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
